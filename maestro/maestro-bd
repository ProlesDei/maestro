#!/usr/bin/env bash
set -euo pipefail

fail() {
  echo "Maestro: $*" >&2
  exit 1
}

unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR
source "$(dirname -- "${BASH_SOURCE[0]}")/maestro-board-store"

t3_thread() {
  timeout -k 1s 5s t3 thread show "$1" --json --messages 0 2>&1 9>&-
}

maestro_session() {
  local id=$1 task=${2-} common=${3-} state life
  [[ -n "$id" ]] || return 1
  if ! state=$(t3_thread "$id"); then
    [[ "$state" == "Thread $id is no longer available." ]] || return 1
    echo gone
    return
  fi
  life=$(jq -er --arg id "$id" '
    .thread | objects | select(.threadId == $id) |
    if .archived == true or .deleted == true then "gone"
    elif .pendingRequestCount > 0 or .activeRunId != null or .blockedOnThreadWait == true or
      (.pendingBackgroundTasks != [] and .pendingBackgroundTasks != null) or
      (.status | IN("preparing", "queued", "starting", "running", "waiting")) then "live"
    elif .pendingRequestCount == 0 and has("activeRunId") and .pendingBackgroundTasks == [] and
      (.status | IN("completed", "cancelled", "failed", "interrupted", "rolled_back")) then "quiet"
    else "unknown" end
  ' <<< "$state") || return 1
  if [[ "$life" == quiet ]]; then
    life=unknown
    if { [[ -z "$common" ]] || task=$(saved_task "$id" "$common"); } &&
       { [[ -z "$task" ]] || [[ "$id" == thread:delegated-task:* && "$task" == "node:${id#thread:}" ]]; } &&
       { [[ -z "$common" ]] ||
         t3_thread "$id" | jq -e --argjson before "$state" '.thread == $before.thread' >/dev/null; }; then
      life=ended
    fi
  fi
  printf '%s\n' "$life"
}

rows() {
  "${driver[@]}" list --brief --limit 0 --json
}

issue() {
  "${driver[@]}" show "$1" --brief-deps --json | jq -ce '.[0] | objects'
}

write_issue() {
  local -a fields
  mapfile -t fields < <(jq -r '.id, (.assignee // ""), .status' <<< "$1")
  shift
  "${driver[@]}" update "${fields[0]}" --if-assignee "${fields[1]}" --if-status "${fields[2]}" "$@" >/dev/null
}

new_token() {
  cat /proc/sys/kernel/random/uuid
}

thread_ended() {
  local state
  state=$(maestro_session "$@") && [[ "$state" == ended || "$state" == gone ]]
}

board_jq() {
  local filter=$1
  shift
  jq "$@" '
    . as $board |
    def slot: .id == "maestro-qa-slot" or .id == "maestro-qa-slot-2";
    def claimed: (.assignee // "") != "";
    def held: .status == "in_progress" or claimed;
    def dispatch: .metadata.maestro_dispatch;
    def planner: .metadata.planner_thread_id;
    def engineer: ((.assignee // "" | select(length > 0)) // dispatch.thread_id // dispatch.planner);
    def qa: (.metadata.qa_thread_id // .assignee);
    def paths: [.labels[]? | select(startswith("touches:")) |
      ltrimstr("touches:") | sub("^\\./"; "") | sub("/+$"; "") | if . == "" then "." else . end];
    def overlap($a; $b): any($a[]; . as $x | any($b[];
      $x == "." or . == "." or . == $x or startswith($x + "/") or (. as $y | $x | startswith($y + "/"))));
    def path_holders($ticket): $ticket | paths as $paths | $board[] |
      select(.id != $ticket.id and .status != "closed" and (claimed or dispatch != null)) |
      select(overlap(paths; $paths));
    def goal: (if .issue_type == "epic" then .id else .parent end) as $id |
      $board[] | select(.id == $id and .status != "closed" and planner != null);
    def pr_key: if type == "string" then
      ascii_downcase | sub("^http://"; "https://") | sub("[?#].*$"; "") |
      sub("/+$"; "") | sub("/0+(?<number>[0-9]+)$"; "/\(.number)") else null end;
    def paired: if has("pairs") then . else
      . + {pairs: ([.tickets // [], (.prs // [] | map(pr_key))] | transpose)} | del(.tickets, .prs) end;
    def batch_key: {name, base, pairs};
    def batch_output: if has("pairs") then
      . + {tickets: [.pairs[][0]], prs: [.pairs[][1]]} | del(.pairs) else . end;
    def prs: [.pairs[]?[1] | strings];
    def valid_batch($batch; $goal): ($batch | prs) as $prs |
      ($prs | length) > 0 and ($prs | unique | length) == ($prs | length) and
      all($batch.pairs[]; . as [$ticket, $pr] |
        ($ticket | type == "string" and length > 0) and ($pr | type == "string" and test("^https://[^/]+/.+")) and
        any($board[]; .id == $ticket and .parent == $goal and .status == "in_progress" and
          ((.external_ref // "" | pr_key) == $pr)));
    def qa_holds: $board[] | select(slot) | (select(held) | .metadata.maestro_qa_batch // {}),
      .metadata.maestro_qa_receipts[]?.batch;
    def qa_candidates:
      ($board | map(select(slot and .status == "blocked" and (held | not))) | sort_by(.id) | first) as $slot |
      if $slot == null then empty else
        [qa_holds | paired | prs] as $holds |
        [$board[] | select(.status != "closed" and planner != null) | . as $goal |
          (.metadata.maestro_qa_queue[]? | paired) as $batch |
          select(valid_batch($batch; $goal.id)) |
          ($batch | prs) as $prs |
          select(all($holds[]; length > 0 and all(.[]; . as $pr | ($prs | index($pr)) == null))) |
          $batch + {goal: $goal.id, planner_thread_id: ($goal | planner),
            task: $goal.metadata.planner_task_id, queue_owner: ($goal.metadata.maestro_qa_queue_owner // ($goal | planner))}] |
        group_by(.goal) | map(min_by(.priority, .eligible_at, .name)) |
        sort_by(.priority, .eligible_at, .goal, .name)[] + {slot: $slot.id}
      end;
  '"$filter"
}

saved_task() (
  local pid port
  board_path --git-dir="$2" || return
  [[ ! -e "$board" && ! -L "$board" ]] && return 0
  board_env
  [[ -f "$BEADS_DIR/metadata.json" && -f "$board/bd.path" ]] && read_bd || return 1
  cd "$board" || return
  read -r pid < server.pid && read -r port < "$BEADS_DIR/dolt-server.port" && board_listening "$port" "$pid" || return 1
  timeout -k 1s 5s "$bd" --sandbox --readonly list --all --brief --limit 0 --json |
    board_jq '
      select(type == "array") |
      [.[] | .metadata as $m |
        (select(engineer == $id) | $m.engineer_task_id),
        (select(planner == $id) | $m.planner_task_id),
        (select($m.review_thread_id == $id) | $m.review_task_id),
        (select(qa == $id) | $m.qa_task_id),
        ($m.maestro_qa_receipts[]? | select(.qa_thread_id == $id) | .qa_task_id)
      ] | map(select(. != null and . != "")) | unique |
      if length == 0 then "" elif length == 1 then .[0] | strings else empty end
    ' -er --arg id "$1"
)

if [[ ${1-} == maestro-session ]]; then
  (( $# == 2 || $# == 3 )) || fail "Usage: maestro-session <thread> [git-common-dir]"
  maestro_session "$2" '' "${3-}"
  exit
fi

ticket_ended() {
  local -a ids
  mapfile -t ids < <(board_jq '
    .metadata as $m | (engineer // ""),
    ($m.engineer_task_id // ""), ($m.review_thread_id // ""), ($m.review_task_id // "")
  ' -r <<< "$1")
  thread_ended "${ids[0]}" "${ids[1]}" && { [[ -z "${ids[2]}" ]] || thread_ended "${ids[2]}" "${ids[3]}"; }
}

release_ticket() {
  write_issue "$1" --assignee '' --status "$2" --unset-metadata maestro_dispatch --unset-metadata engineer_task_id
}

ready_ticket() {
  local id=$1 parent=$2 ready
  ready=$("${driver[@]}" ready --unassigned --parent "$parent" --limit 0 --brief --json)
  jq -e --arg id "$id" 'any(.[]; .id == $id)' <<< "$ready" >/dev/null ||
    fail "$id is not ready"
}

reserve_ticket() {
  local id=$1 ticket parent board_rows status metadata handoff=null
  shift
  ticket=$(issue "$id")
  board_rows=$(rows)
  parent=$(board_jq '[$ticket | goal | select(planner == $owner)][0].id // empty' -r \
    --argjson ticket "$ticket" --arg owner "$actor" <<< "$board_rows")
  [[ -n "$parent" ]] || fail "$id is not on your goal"
  status=$(jq -r .status <<< "$ticket")
  if (( $# )); then
    [[ "$(jq -r '.assignee // ""' <<< "$ticket")" == "$1" ]] || fail "$id changed hands"
    [[ "$status" == open || "$status" == in_progress ]] || fail "$id is $status"
    if jq -e '(.assignee // "") != "" or .metadata.maestro_dispatch != null' <<< "$ticket" >/dev/null; then
      ticket_ended "$ticket" || fail "$id still has live or unverified work"
    fi
    local worktree branch common_dir
    worktree=$(realpath -e -- "$2")
    branch=$3
    common_dir=$(git -C "$primary" rev-parse --path-format=absolute --git-common-dir)
    [[ "$worktree" != "$primary" &&
       "$(git -C "$worktree" rev-parse --show-toplevel)" == "$worktree" &&
       "$(git -C "$worktree" rev-parse --path-format=absolute --git-common-dir)" == "$common_dir" &&
       "$(git -C "$worktree" symbolic-ref --quiet --short HEAD)" == "$branch" ]] ||
      fail "Worktree and branch do not match this repo"
    handoff=$(jq -nc --arg worktree "$worktree" --arg branch "$branch" '{$worktree, $branch}')
  else
    jq -e '(.assignee // "") == "" and .metadata.maestro_dispatch == null' <<< "$ticket" >/dev/null ||
      fail "$id already has a claim or reservation"
  fi
  if [[ "$status" == open ]]; then
    ready_ticket "$id" "$parent"
  else
    jq -e 'all(.dependencies[]?; .status == "closed" or
      (.dependency_type | IN("blocks", "conditional-blocks", "waits-for") | not))' <<< "$ticket" >/dev/null ||
      fail "$id still has open prerequisites"
  fi
  check_paths "$ticket" "$board_rows"
  metadata=$(jq -nc --arg token "$(new_token)" --arg planner "$actor" --argjson handoff "$handoff" '
    {engineer_task_id: null, maestro_dispatch: {$token, $planner, $handoff}}')
  write_issue "$ticket" --assignee '' --status open --metadata "$metadata"
  jq -c --arg id "$id" '.maestro_dispatch + {ticket: $id}' <<< "$metadata"
}

check_paths() {
  local holder
  holder=$(board_jq '[path_holders($ticket)][0].id // empty' -r --argjson ticket "$1" <<< "$2")
  [[ -z "$holder" ]] || fail "$(jq -r .id <<< "$1") shares a declared path with $holder"
}

engineer_claim() {
  local ticket parent metadata path
  ticket=$(issue "$1")
  jq -e --arg token "$2" --arg id "$actor" '
    (.assignee // "") == "" and .status == "open" and
    (.metadata.maestro_dispatch | .token == $token and (.thread_id // $id) == $id)
  ' <<< "$ticket" >/dev/null || fail "Reservation no longer permits $actor to claim $1"
  path=$(jq -r '.metadata.maestro_dispatch.handoff.worktree // empty' <<< "$ticket")
  if [[ -n "$path" ]]; then
    [[ "$(git -C "$source_dir" rev-parse --show-toplevel)" == "$path" &&
       "$(git -C "$source_dir" symbolic-ref --quiet --short HEAD)" == "$(jq -r '.metadata.maestro_dispatch.handoff.branch' <<< "$ticket")" ]] ||
      fail "Launch the engineer in the reserved worktree and branch"
  fi
  parent=$(jq -er '.parent' <<< "$ticket")
  ready_ticket "$1" "$parent"
  check_paths "$ticket" "$(rows)"
  metadata=$(jq -c --arg id "$actor" '{maestro_dispatch: (.metadata.maestro_dispatch + {thread_id: $id})}' <<< "$ticket")
  write_issue "$ticket" --assignee "$actor" --status in_progress --metadata "$metadata"
}

bind_child() {
  local id=$1 token=$2 thread=$3 task=${4-} ticket metadata
  [[ -n "$thread" ]] || fail "Need the child thread ID"
  ticket=$(issue "$id")
  metadata=$(jq -ce --arg owner "$actor" --arg token "$token" --arg thread "$thread" --arg task "$task" '
    .metadata as $m | $m.maestro_dispatch as $dispatch |
    if .id | IN("maestro-qa-slot", "maestro-qa-slot-2") then
      select(.status == "in_progress" and .assignee == $owner and $m.maestro_qa_batch.token == $token and
        ($m.qa_thread_id // $thread) == $thread and ($m.qa_task_id // $task) == $task) |
      {qa_thread_id: $thread, qa_task_id: $task}
    else
      select((.assignee // "") | IN("", $thread)) |
      select(($m.engineer_task_id // $task) == $task and $dispatch.planner == $owner and
        $dispatch.token == $token and ($dispatch.thread_id // $thread) == $thread) |
      {maestro_dispatch: ($dispatch + {thread_id: $thread}), engineer_task_id: $task}
    end
  ' <<< "$ticket") || fail "$id no longer holds that reservation"
  write_issue "$ticket" --metadata "$metadata"
}

sync_qa() {
  local goal input metadata
  goal=$(issue "$1")
  jq -e --arg owner "$actor" '.issue_type == "epic" and .status != "closed" and .metadata.planner_thread_id == $owner' \
    <<< "$goal" >/dev/null || fail "You do not hold goal $1"
  input=$(jq -ce '
    select(type == "array" and all(.[];
      (.name | type == "string" and length > 0) and
      (.base | type == "string" and length > 0) and (.priority | IN(0, 1, 2, 3)) and
      (.tickets | type == "array" and length > 0) and (.prs | type == "array") and
      (.prs | length) == (.tickets | length))) |
    map({name, base, priority, tickets, prs}) |
    select(length == (map([.base, .name]) | unique | length))
  ' "$2") || fail "Expected QA batches with name, base, priority, tickets and corresponding PR URLs"
  metadata=$(rows | board_jq '
    $goal.metadata | (.maestro_qa_queue_owner // $owner) as $old_owner |
    [select($old_owner == $owner) | .maestro_qa_queue[]? | paired] as $old |
    {maestro_qa_queue_owner: $owner, maestro_qa_queue: [
      ($input | to_entries[]) | .key as $i | (.value | paired) as $batch |
      select(valid_batch($batch; $goal.id)) |
      ([$old[] | select(batch_key == ($batch | batch_key))][0] //
        {eligible_at: $now, token: ($seed + "-" + ($i | tostring))}) as $entry |
      $batch + ($entry | {eligible_at, token})] | sort_by(.base, .name)}
  ' -c --argjson goal "$goal" --argjson input "$input" --arg owner "$actor" \
    --arg now "$(date +%s%N)" --arg seed "$(new_token)")
  [[ "$(jq -c '.metadata | {maestro_qa_queue_owner, maestro_qa_queue}' <<< "$goal")" == "$metadata" ]] ||
    write_issue "$goal" --metadata "$metadata"
}

next_live_qa() {
  local candidates batch goal planner task owner state
  local -a fields
  candidates=$(rows | board_jq 'qa_candidates' -c) || return
  while IFS= read -r batch && [[ -n "$batch" ]]; do
    mapfile -t fields < <(jq -r '.goal, .planner_thread_id, (.task // ""), .queue_owner' <<< "$batch")
    goal=${fields[0]} planner=${fields[1]} task=${fields[2]} owner=${fields[3]}
    state=gone
    if [[ "$owner" == "$planner" ]]; then
      state=live
      if [[ "$planner" != "$actor" ]]; then
        state=$(maestro_session "$planner" "$task") || continue
      fi
    fi
    case $state in
      gone) write_issue "$(issue "$goal")" --unset-metadata maestro_qa_queue --unset-metadata maestro_qa_queue_owner || return ;;
      live) jq -c 'del(.task, .queue_owner)' <<< "$batch"; return ;;
    esac
  done <<< "$candidates"
}

claim_qa() {
  local batch slot
  batch=$(next_live_qa)
  if [[ -z "$batch" ]]; then
    echo null
  elif [[ "$(jq -r .planner_thread_id <<< "$batch")" != "$actor" ]]; then
    jq -c '{state: "waiting", planner_thread_id}' <<< "$batch"
  else
    slot=$(issue "$(jq -r .slot <<< "$batch")")
    write_issue "$slot" --assignee "$actor" --status in_progress --metadata "$(jq -c '
      {qa_thread_id: null, qa_task_id: null, maestro_qa_batch: .}
    ' <<< "$batch")"
    board_jq 'batch_output + {state: "claimed"}' -c <<< "$batch"
  fi
}

qa_slot() {
  local slot
  [[ "$1" == maestro-qa-slot || "$1" == maestro-qa-slot-2 ]] || fail "$1 is not a QA slot"
  slot=$(issue "$1")
  jq -ce --arg token "$2" '
    select(.status == "in_progress" and (.metadata.maestro_qa_batch.token // "") == $token)
  ' <<< "$slot" || fail "$1 no longer holds that batch"
}

check_qa() {
  [[ "$(jq -r '.metadata.qa_thread_id // empty' <<< "$1")" == "$actor" ]] ||
    fail "$(jq -r .id <<< "$1") is not bound to this QA thread"
}

merge_qa() {
  local id=$1 token=$2 remote=$3 tested_base=$4 slot ref key current
  shift 4
  slot=$(qa_slot "$id" "$token")
  check_qa "$slot"
  ref=$(jq -er '.metadata.maestro_qa_batch.base | strings | select(length > 0) | "refs/heads/" + .' <<< "$slot") ||
    fail "QA batch has no base branch"
  key=$(printf '%s' "$ref" | sha256sum)
  set -m
  (
    exec 8>>"$board/maestro-merge-${key%% *}.lock"
    flock -w 30 8 || fail "QA base is busy. Retry shortly."
    current=$(timeout -k 2s 15s git -C "$source_dir" ls-remote --exit-code --refs -- "$remote" "$ref" 8>&-) ||
      fail "Could not read QA base $ref from $remote"
    [[ "$current" == "$tested_base"$'\t'"$ref" ]] || fail "QA base moved since testing"
    board_lock
    slot=$(qa_slot "$id" "$token")
    check_qa "$slot"
    exec 9>&-
    cd "$source_dir"
    kill -0 "$$" || exit 1
    exec timeout --foreground -k 2s 90s bash -c 'exec 8>&-; exec -- "$@"' maestro-merge "$@"
  ) <&0 &
  set +m
  wait "$!"
}

finish_qa() {
  local slot=$1 batch goal metadata token
  batch=$(jq -c '.metadata.maestro_qa_batch // {}' <<< "$slot")
  token=$(jq -r '.token // empty' <<< "$batch")
  if [[ -z "$token" ]]; then
    token=$(new_token)
  else
    goal=$(issue "$(jq -r .goal <<< "$batch")")
    write_issue "$goal" --metadata "$(jq -c --arg token "$token" '
      {maestro_qa_queue: (.metadata.maestro_qa_queue // [] | map(select(.token != $token)))}
    ' <<< "$goal")" || return
  fi
  metadata=$(jq -c --arg token "$token" --argjson batch "$batch" '
    . as $slot | .metadata |
    {maestro_qa_receipts: ((.maestro_qa_receipts // []) +
      [{slot: $slot.id, $token, $batch, assignee: $slot.assignee, qa_thread_id, qa_task_id}]),
      maestro_qa_batch: null, qa_thread_id: null, qa_task_id: null}
  ' <<< "$slot")
  write_issue "$slot" --assignee '' --status blocked --metadata "$metadata" || return
  board_jq '.maestro_qa_receipts[-1] | .batch |= batch_output' -c <<< "$metadata"
}

ack_qa() {
  local slot goal receipt metadata
  slot=$(issue "$1")
  receipt=$(jq -ce --arg token "$2" '.metadata.maestro_qa_receipts[]? | select(.token == $token)' <<< "$slot") ||
    fail "No matching QA receipt"
  goal=$(jq -r '.batch.goal // empty' <<< "$receipt")
  if [[ -n "$goal" ]]; then
    goal=$(issue "$goal")
    [[ "$(jq -r '.metadata.planner_thread_id' <<< "$goal")" == "$actor" ]] || fail "Receipt belongs to another goal"
  fi
  metadata=$(jq -c --arg token "$2" '
    {maestro_qa_receipts: (.metadata.maestro_qa_receipts | map(select(.token != $token)))}
  ' <<< "$slot")
  write_issue "$slot" --metadata "$metadata"
}

reap_claims() {
  local board_rows candidates id ticket status qa target receipt
  board_rows=$(rows)
  candidates=$(board_jq '
    .[] | select(if slot then .status == "in_progress" else
      (.status | IN("open", "in_progress", "blocked")) and .issue_type != "epic" and (claimed or dispatch != null) end) | .id
  ' -r <<< "$board_rows")
  while IFS= read -r id && [[ -n "$id" ]]; do
    (
      board_lock
      ticket=$(issue "$id") || exit 0
      status=$(jq -r .status <<< "$ticket")
      if [[ "$id" == maestro-qa-slot || "$id" == maestro-qa-slot-2 ]]; then
        [[ "$status" == in_progress ]] || exit 0
        qa=$(board_jq 'qa // ""' -r <<< "$ticket")
        thread_ended "$qa" "$(jq -r '.metadata.qa_task_id // ""' <<< "$ticket")" || exit 0
        receipt=$(finish_qa "$ticket")
        board_jq '$receipt + {planner_thread_id: ([$board[] | select(.id == $receipt.batch.goal) | planner][0] // $receipt.assignee)}' \
          -c --argjson receipt "$receipt" <<< "$board_rows"
        exit
      fi
      [[ "$status" == open || "$status" == in_progress || "$status" == blocked ]] || exit 0
      ticket_ended "$ticket" || exit 0
      target=$(jq -r 'if .status == "blocked" or (.status == "in_progress" and .external_ref != null)
        then .status else "open" end' <<< "$ticket")
      release_ticket "$ticket" "$target"
      board_jq '$ticket | {ticket: .id, assignee, engineer_thread_id: ((.assignee | select(. != "")) // dispatch.thread_id),
        engineer_task_id: .metadata.engineer_task_id, review_thread_id: .metadata.review_thread_id,
        planner_thread_id: ([goal | planner][0] // null)}' -c --argjson ticket "$ticket" <<< "$board_rows"
    )
  done <<< "$candidates" | jq -sc .
}

wake_targets() {
  local changed
  if [[ "$1" == qa ]]; then
    board_lock
    next_live_qa | jq -sc '[.[].planner_thread_id]'
  else
    changed=$(issue "$1")
    rows | board_jq '[
      $changed, ($board[] | select(.status != "closed" and .id != $changed.id) | select(
        ($changed.status == "closed" and any(.dependencies[]?; .depends_on_id == $changed.id and (.type | IN("blocks", "conditional-blocks", "waits-for", "tracks")))) or
        (.status == "open" and (claimed | not) and dispatch == null and overlap(paths; ($changed | paths)))
      )) | goal | planner
    ] | unique' -c --argjson changed "$changed"
  fi
}

source_dir=$PWD
if [[ ${1-} == maestro-setup ]]; then
  open_board setup "${@:2}"
  exit
fi
open_board ''

require_args() {
  local expected=$1 usage=$2 count=$3
  (( count == expected )) || fail "Usage: maestro-$action${usage:+ $usage}"
}

if [[ ${1-} == maestro-* ]]; then
  action=${1#maestro-}
  actor=${T3CODE_THREAD_ID-}
  shift
  [[ -z "$actor" ]] || driver+=(--actor "$actor")
  case $action in
    reap) require_args 0 '' "$#"; reap_claims; exit ;;
    wake-targets) require_args 1 '<ticket|qa>' "$#"; wake_targets "$1"; exit ;;
  esac
  [[ -n "$actor" ]] || fail "Need a T3 thread ID"
  if [[ "$action" == qa-merge ]]; then
    [[ $# -ge 6 && "$5" == -- ]] ||
      fail "Usage: maestro-qa-merge <slot> <token> <remote> <tested base SHA> -- <merge command> [args...]"
    merge_qa "$1" "$2" "$3" "$4" "${@:6}"
    exit
  fi
  board_lock
  case $action in
    reserve)
      require_args 1 '<ticket>' "$#"
      reserve_ticket "$1" ;;
    reassign)
      require_args 4 '<ticket> <observed assignee> <worktree> <branch>' "$#"
      reserve_ticket "$@" ;;
    engineer-claim)
      require_args 2 '<ticket> <token>' "$#"
      engineer_claim "$@" ;;
    engineer-check)
      (( $# == 1 || $# == 2 )) || fail "Usage: maestro-engineer-check <ticket> [token]"
      jq -e --arg owner "$actor" --arg token "${2-}" '
        .status == "in_progress" and .assignee == $owner and (.metadata.maestro_dispatch.token // "") == $token
      ' <<< "$(issue "$1")" >/dev/null || fail "$1 no longer holds your engineer claim" ;;
    bind-child)
      (( $# == 3 || $# == 4 )) || fail "Usage: maestro-bind-child <ticket|slot> <token> [task]"
      bind_child "$@" ;;
    release-ticket)
      (( $# == 4 || $# == 5 )) ||
        fail "Usage: maestro-release-ticket <ticket> <observed assignee> <observed status> <open|blocked|in_progress> [token]"
      ticket=$(issue "$1")
      jq -e --arg assignee "$2" --arg status "$3" --arg token "${5-}" '
        (.assignee // "") == $assignee and .status == $status and (.metadata.maestro_dispatch.token // "") == $token
      ' <<< "$ticket" >/dev/null || fail "$1 changed hands, status or reservation"
      [[ "$3" == open || "$3" == blocked || "$3" == in_progress ]] || fail "Cannot release a $3 ticket"
      [[ "$4" == open || "$4" == blocked || "$4" == in_progress ]] || fail "Invalid release status: $4"
      if [[ "$actor" != "$2" ]] && ! jq -e --arg owner "$actor" '
        (.assignee // "") == "" and (.metadata.maestro_dispatch | .planner == $owner and .thread_id == null)
      ' <<< "$ticket" >/dev/null; then
        ticket_ended "$ticket" || fail "$1 still has live or unverified work"
      fi
      release_ticket "$ticket" "$4" ;;
    qa-sync)
      require_args 2 '<epic> <absolute JSON file or ->' "$#"
      [[ "$2" == /* || "$2" == - ]] || fail "Use an absolute path for the QA queue file"
      sync_qa "$@" ;;
    qa-claim)
      require_args 0 '' "$#"
      claim_qa ;;
    qa-ack|qa-check|qa-release)
      require_args 2 '<slot> <token>' "$#"
      [[ "$1" == maestro-qa-slot || "$1" == maestro-qa-slot-2 ]] || fail "$1 is not a QA slot"
      case $action in
        qa-ack) ack_qa "$@" ;;
        qa-check) check_qa "$(qa_slot "$@")" ;;
        qa-release)
          slot=$(qa_slot "$@")
          qa=$(jq -r '.metadata.qa_thread_id // empty' <<< "$slot")
          [[ "$(jq -r '.assignee // ""' <<< "$slot")" == "$actor" ]] || fail "$1 is held by another planner"
          [[ -z "$qa" ]] || thread_ended "$qa" "$(jq -r '.metadata.qa_task_id // ""' <<< "$slot")" ||
            fail "$1 still has live or unverified QA work"
          finish_qa "$slot" ;;
      esac ;;
    *) fail "Unknown maestro-bd action: maestro-$action" ;;
  esac
  exit
fi

for (( index=1; index<=$#; index++ )); do
  case ${!index} in
    --) break ;;
    --*=*|--cpu-profile|--global|--help|-h|--ignore-schema-skew|--json|--no-color|-q|--quiet|--readonly|--sandbox|-v|--verbose|-V|--version) ;;
    --*|-?) (( index+=1 )) ;;
    -??*) ;;
    *) break ;;
  esac
done
case ${!index-} in
  ready)
    extra=(--limit 0) json= full=
    for arg; do
      case $arg in
        --json|--json=true) json=1 ;;
        --brief|--brief=*|--claim|--claim=*|--gated|--gated=*|--mol|--mol=*|--explain|--explain=*) full=1 ;;
      esac
    done
    [[ -z $json || -n $full ]] || extra+=(--brief)
    [[ -z "$full" ]] || board_lock
    set -- "${@:1:index}" "${extra[@]}" "${@:index+1}" ;;
  list|show|status|version|--help|-h|'') ;;
  *) board_lock ;;
esac
exec "${driver[@]}" "$@"
