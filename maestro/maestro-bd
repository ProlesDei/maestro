#!/usr/bin/env bash
set -eu

fail() {
  echo "Maestro: $*" >&2
  exit 1
}

ensure_qa_slot() {
  local slot
  slot=$("$bd" --sandbox --dolt-auto-commit on list --all --id maestro-qa-slot --json) ||
    fail "Board query failed at $board (port $port)"
  if [[ "$slot" == '[]' ]]; then
    "$bd" --sandbox --dolt-auto-commit on create "Maestro QA slot" --id maestro-qa-slot \
      --type task --status blocked --description "Only one QA session can run at a time." >/dev/null ||
      fail "Could not create maestro-qa-slot at $board (port $port)"
  fi
}

IFS= read -r -d '' worktree < <(git worktree list --porcelain -z)
primary=$(cd "${worktree#worktree }" && pwd -P)
digest=$(printf '%s' "$primary" | sha256sum)
store="$HOME/.local/share/maestro-board"
board="$store/${primary##*/}-${digest:0:12}"
for var in $(compgen -e); do
  case $var in
    BEADS_ACTOR|BD_ACTOR) ;;
    BEADS_*|BD_*) unset "$var" ;;
  esac
done
export GIT_CEILING_DIRECTORIES="$store"
export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=beads.role GIT_CONFIG_VALUE_0=maintainer
export BEADS_DIR="$board/.beads" BD_DISABLE_METRICS=1 BD_DISABLE_EVENT_FLUSH=1
export DOLT_ROOT_PATH="$board" DOLT_DISABLE_EVENT_FLUSH=1

if [[ ${1-} == maestro-setup ]]; then
  shift
  (( $# <= 1 )) || fail "Usage: maestro-bd maestro-setup [port]"
  umask 077
  bd=$(type -P bd) && bd=$(realpath -- "$bd") &&
    "$bd" --version | grep -Eq '^bd version 1\.3\.4( |$)' || fail "Need bd 1.3.4 on PATH"
  for tool in ss setsid flock; do command -v "$tool" >/dev/null || fail "Need $tool on PATH"; done

  mkdir -p -- "$store"
  version=$(DOLT_ROOT_PATH="$store" DOLT_DISABLE_VERSION_CHECKS=true dolt version) ||
    fail "Need Dolt 2.2.0 on PATH"
  version=${version%%$'\n'*}
  [[ "$version" == "dolt version 2.2.0" ]] || fail "Need Dolt 2.2.0 on PATH. Found $version"

  saved=
  if [[ -f "$BEADS_DIR/metadata.json" ]]; then
    [[ -f "$BEADS_DIR/dolt-server.port" ]] || fail "Missing $BEADS_DIR/dolt-server.port"
    saved=$(<"$BEADS_DIR/dolt-server.port")
  fi
  if [[ -f "$board/server.pid" ]]; then
    pid=$(<"$board/server.pid")
    if [[ -n "$pid" && -n "$saved" && "$(ss -Hltpn "sport = :$saved")" == *"pid=$pid,"* ]]; then
      [[ ${1-$saved} == "$saved" ]] || fail "Board is running on port $saved. Stop it before changing ports"
      port=$saved
      cd "$board"
      ensure_qa_slot
      printf '%s\n' "$bd" > "$board/bd.path"
      echo "Maestro board already running at $board (port $saved, PID $pid)"
      exit 0
    fi
    rm -- "$board/server.pid"
  fi
  port=${1-${saved:-3307}}
  [[ "$port" =~ ^[1-9][0-9]{0,4}$ ]] && (( port <= 65535 )) ||
    fail "Invalid board port: $port"
  listeners=$(ss -Hltpn "sport = :$port")
  [[ -z "$listeners" ]] ||
    fail "Port $port is already in use. Pass a free port: .maestro/maestro-bd maestro-setup <port>"

  mkdir -p -- "$board/sql"
  cd "$board"
  dolt config --global --add metrics.disabled true
  dolt config --global --add versioncheck.disabled true
  setsid nohup dolt sql-server --host 127.0.0.1 --port "$port" --data-dir "$board/sql" \
    </dev/null >>server.log 2>&1 &
  pid=$!
  trap 'kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true' EXIT
  for (( attempt=0; attempt<100; attempt++ )); do
    listeners=$(ss -Hltpn "sport = :$port")
    [[ "$listeners" == *"pid=$pid,"* ]] && break
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  [[ "$listeners" == *"pid=$pid,"* ]] ||
    fail "Dolt failed to listen on port $port. See $board/server.log"

  if [[ ! -f "$BEADS_DIR/metadata.json" ]]; then
    "$bd" --sandbox init --server --external --server-host 127.0.0.1 --server-port "$port" \
      --server-user root --prefix maestro --skip-agents --skip-hooks --non-interactive
  fi
  printf '%s\n' "$port" > "$BEADS_DIR/dolt-server.port"
  ensure_qa_slot
  printf '%s\n' "$bd" > bd.path
  printf '%s\n' "$pid" > server.pid
  trap - EXIT
  echo "Maestro board started at $board (port $port, PID $pid)"
  exit 0
fi

[[ -f "$BEADS_DIR/metadata.json" && -f "$board/bd.path" ]] ||
  fail "Run .maestro/maestro-bd maestro-setup to set up the board at $board"
cd "$board"
read -r bd < bd.path
[[ "$bd" == /* && -x "$bd" ]] || fail "Verified bd is missing at $bd. Rerun board setup"

for (( index=1; index<=$#; index++ )); do
  case ${!index} in
    --) break ;;
    --*=*|--cpu-profile|--global|--help|-h|--ignore-schema-skew|--json|--no-color|-q|--quiet|--readonly|--sandbox|-v|--verbose|-V|--version) ;;
    --*|-?) (( index+=1 )) ;;
    -??*) ;;
    *) break ;;
  esac
done
driver=("$bd" --sandbox --dolt-auto-commit on)

case ${!index-} in
  ready)
    extra=(--limit 0) json= full=
    for arg; do
      case $arg in
        --json|--json=true) json=1 ;;
        --brief|--brief=*|--claim|--claim=*|--gated|--gated=*|--mol|--mol=*|--explain|--explain=*) full=1 ;;
      esac
    done
    [[ -z $json || -n $full ]] || extra+=(--brief)
    set -- "${@:1:index}" "${extra[@]}" "${@:index+1}" ;;
  create|new) exec 9>>create.lock; flock -w 30 9 || fail "Board is busy. Retry shortly." ;;
esac
exec "${driver[@]}" "$@"
