#!/usr/bin/env bash
set -euo pipefail

fail() {
  echo "Maestro: $*" >&2
  exit 1
}

board_lock() {
  exec 9>>"$board/maestro-board.lock"
  flock -w 30 9 || fail "Board is busy. Retry shortly."
}

start_server() {
  local listeners attempt
  listeners=$(ss -Hltpn "sport = :$port")
  if [[ -f server.pid ]]; then
    read -r pid < server.pid
    if [[ "$pid" =~ ^[1-9][0-9]*$ && "$listeners" == *"pid=$pid,"* ]]; then
      return
    fi
  fi
  [[ -z "$listeners" ]] ||
    fail "Port $port is already in use. Pass a free port to maestro-setup"
  if [[ -n "$saved" && "$saved" != "$port" && "$pid" =~ ^[1-9][0-9]*$ ]]; then
    [[ "$(ss -Hltpn "sport = :$saved")" != *"pid=$pid,"* ]] ||
      fail "Board is running on port $saved. Stop it before changing ports"
  fi
  mkdir -p sql
  setsid nohup dolt sql-server --host 127.0.0.1 --port "$port" --data-dir "$board/sql" \
    </dev/null >>server.log 2>&1 9>&- &
  pid=$!
  trap 'kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true' EXIT
  for (( attempt=0; attempt<100; attempt++ )); do
    listeners=$(ss -Hltpn "sport = :$port")
    [[ "$listeners" == *"pid=$pid,"* ]] && break
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  [[ "$listeners" == *"pid=$pid,"* ]] ||
    fail "Dolt failed to listen on port $port. See $board/server.log"
  printf '%s\n' "$pid" > server.pid
}

ensure_qa_slots() {
  local slots id
  slots=$("${driver[@]}" list --all --id maestro-qa-slot,maestro-qa-slot-2 --json) ||
    fail "Board query failed at $board (port $port)"
  for id in maestro-qa-slot maestro-qa-slot-2; do
    if ! jq -e --arg id "$id" 'any(.[]; .id == $id)' <<< "$slots" >/dev/null; then
      "${driver[@]}" create "Maestro QA slot" --id "$id" --type task --status blocked >/dev/null
    fi
  done
  touch maestro-qa-slots-v2
}

rows() {
  "${driver[@]}" list --brief --limit 0 --json
}

issue() {
  "${driver[@]}" show "$1" --brief-deps --json | jq -ce '
    .[0] | objects | {id, issue_type, parent, status, assignee, revision, labels, dependencies, metadata, external_ref}
  '
}

write_issue() {
  local id assignee status
  IFS=$'\t' read -r id status < <(jq -r '[.id, .status] | @tsv' <<< "$1")
  assignee=$(jq -r '.assignee // ""' <<< "$1")
  shift
  "${driver[@]}" update "$id" --if-assignee "$assignee" --if-status "$status" "$@" >/dev/null
}

new_token() {
  cat /proc/sys/kernel/random/uuid
}

thread_ended() {
  local state
  [[ -n "$1" ]] || return 1
  state=$(timeout -k 1s 5s t3 thread show "$1" --json --messages 0 2>/dev/null 9>&-) || return 1
  jq -e --arg id "$1" '
    .thread | objects | .threadId == $id and .activeRunId == null
    and ((.pendingBackgroundTasks // []) | all(.kind != "subagent" and .childThreadId == null))
  ' <<< "$state" >/dev/null
}

board_jq() {
  local filter=$1
  shift
  jq "$@" '
    . as $board |
    def slot: .id == "maestro-qa-slot" or .id == "maestro-qa-slot-2";
    def claimed: (.assignee // "") != "";
    def held: .status == "in_progress" or claimed;
    def dispatch: .metadata.maestro_dispatch;
    def planner: .metadata.planner_thread_id;
    def paths: [.labels[]? | select(startswith("touches:")) |
      ltrimstr("touches:") | sub("^\\./"; "") | sub("/+$"; "") | if . == "" then "." else . end];
    def overlap($a; $b): any($a[]; . as $x | any($b[];
      $x == "." or . == "." or . == $x or startswith($x + "/") or (. as $y | $x | startswith($y + "/"))));
    def path_holders($ticket): $ticket | paths as $paths | $board[] |
      select(.id != $ticket.id and .status != "closed" and (claimed or dispatch != null)) |
      select(overlap(paths; $paths));
    def goal: (if .issue_type == "epic" then .id else .parent end) as $id |
      $board[] | select(.id == $id and .status != "closed" and planner != null);
    def pr_key: ascii_downcase | sub("^http://"; "https://") | sub("[?#].*$"; "") |
      sub("/+$"; "") | sub("/0+(?<number>[0-9]+)$"; "/\(.number)");
    def valid_batch($batch; $goal):
      ($batch.prs | map(pr_key)) as $prs |
      ($prs | unique | length) == ($prs | length) and all(range($batch.tickets | length); . as $i |
        any($board[]; .id == $batch.tickets[$i] and .parent == $goal and .status == "in_progress" and
          ((.external_ref // "" | pr_key) == $prs[$i])));
    def batch_key: {name, base, tickets, prs: [.prs[] | pr_key]};
    def qa_holds: $board[] | select(slot) | (select(held) | .metadata.maestro_qa_batch // {}),
      .metadata.maestro_qa_receipts[]?.batch;
    def next_qa:
      ($board | map(select(slot and .status == "blocked" and (held | not))) | sort_by(.id) | first) as $slot |
      if $slot == null then empty else
        [qa_holds] as $holds |
        [$board[] | select(.status != "closed" and planner != null) | . as $goal |
          .metadata.maestro_qa_queue[]? as $batch |
          select(valid_batch($batch; $goal.id)) |
          select(all($holds[]; (.prs // [] | length) > 0 and
            all(.prs[]; pr_key as $pr | ($batch.prs | map(pr_key) | index($pr)) == null))) |
          $batch + {goal: $goal.id, planner_thread_id: ($goal | planner)}] |
        sort_by(.priority, .eligible_at, .goal, .name) | first | select(. != null) + {slot: $slot.id}
      end;
  '"$filter"
}

caller() {
  [[ -n "${T3CODE_THREAD_ID-}" ]] || fail "Need a T3 thread ID"
  printf '%s\n' "$T3CODE_THREAD_ID"
}

ticket_ended() {
  local ticket=$1 thread review planner
  thread=$(jq -r '(.assignee | select(. != "")) // .metadata.maestro_dispatch.thread_id // ""' <<< "$ticket")
  review=$(jq -r '.metadata.review_thread_id // ""' <<< "$ticket")
  planner=$(jq -r '.metadata.maestro_dispatch.planner // ""' <<< "$ticket")
  [[ -n "$thread" ]] || thread=$planner
  thread_ended "$thread" && { [[ -z "$review" ]] || thread_ended "$review"; }
}

release_ticket() {
  write_issue "$1" --assignee '' --status "$2" --unset-metadata maestro_dispatch --unset-metadata engineer_task_id
}

ready_ticket() {
  local id=$1 parent=$2 ready
  ready=$("${driver[@]}" ready --unassigned --parent "$parent" --limit 0 --brief --json)
  jq -e --arg id "$id" 'any(.[]; .id == $id)' <<< "$ready" >/dev/null ||
    fail "$id is not ready"
}

reserve_ticket() {
  local id=$1 ticket parent board_rows owner status token metadata handoff=null
  shift
  owner=$(caller)
  ticket=$(issue "$id")
  board_rows=$(rows)
  parent=$(board_jq '[$ticket | goal | select(planner == $owner)][0].id // empty' -r \
    --argjson ticket "$ticket" --arg owner "$owner" <<< "$board_rows")
  [[ -n "$parent" ]] || fail "$id is not on your goal"
  status=$(jq -r .status <<< "$ticket")
  if (( $# )); then
    (( $# == 3 )) || fail "Usage: maestro-reassign <ticket> <observed assignee> <worktree> <branch>"
    [[ "$(jq -r '.assignee // ""' <<< "$ticket")" == "$1" ]] || fail "$id changed hands"
    [[ "$status" == open || "$status" == in_progress ]] || fail "$id is $status"
    if jq -e '(.assignee // "") != "" or .metadata.maestro_dispatch != null' <<< "$ticket" >/dev/null; then
      ticket_ended "$ticket" || fail "$id still has live or unverified work"
    fi
    local worktree branch pr common_dir
    worktree=$(realpath -e -- "$2")
    branch=$3
    common_dir=$(git -C "$primary" rev-parse --path-format=absolute --git-common-dir)
    [[ "$worktree" != "$primary" &&
       "$(git -C "$worktree" rev-parse --show-toplevel)" == "$worktree" &&
       "$(git -C "$worktree" rev-parse --path-format=absolute --git-common-dir)" == "$common_dir" &&
       "$(git -C "$worktree" symbolic-ref --quiet --short HEAD)" == "$branch" ]] ||
      fail "Worktree and branch do not match this repo"
    pr=$(jq -c '.external_ref // null' <<< "$ticket")
    handoff=$(jq -nc --argjson pr "$pr" --arg worktree "$worktree" --arg branch "$branch" '{$pr, $worktree, $branch}')
  else
    jq -e '(.assignee // "") == "" and .metadata.maestro_dispatch == null' <<< "$ticket" >/dev/null ||
      fail "$id already has a claim or reservation"
  fi
  if [[ "$status" == open ]]; then
    ready_ticket "$id" "$parent"
  else
    jq -e 'all(.dependencies[]?; .status == "closed" or
      (.dependency_type | IN("blocks", "conditional-blocks", "waits-for") | not))' <<< "$ticket" >/dev/null ||
      fail "$id still has open prerequisites"
  fi
  check_paths "$ticket" "$board_rows"
  token=$(new_token)
  metadata=$(jq -c --arg token "$token" --arg planner "$owner" --argjson handoff "$handoff" '
    {engineer_task_id: null, maestro_dispatch: {$token, $planner, $handoff}}
  ' <<< "$ticket")
  write_issue "$ticket" --assignee '' --status open --metadata "$metadata"
  jq -c --arg id "$id" '.maestro_dispatch + {ticket: $id}' <<< "$metadata"
}

check_paths() {
  local holder
  holder=$(board_jq '[path_holders($ticket)][0].id // empty' -r --argjson ticket "$1" <<< "$2")
  [[ -z "$holder" ]] || fail "$(jq -r .id <<< "$1") shares a declared path with $holder"
}

engineer_claim() {
  local ticket parent engineer metadata path
  engineer=$(caller)
  ticket=$(issue "$1")
  jq -e --arg token "$2" --arg id "$engineer" '
    (.assignee // "") == "" and .status == "open" and
    (.metadata.maestro_dispatch | .token == $token and (.thread_id // $id) == $id)
  ' <<< "$ticket" >/dev/null || fail "Reservation no longer permits $engineer to claim $1"
  path=$(jq -r '.metadata.maestro_dispatch.handoff.worktree // empty' <<< "$ticket")
  if [[ -n "$path" ]]; then
    [[ "$source_root" == "$path" && "$source_branch" == "$(jq -r '.metadata.maestro_dispatch.handoff.branch' <<< "$ticket")" ]] ||
      fail "Launch the engineer in the reserved worktree and branch"
  fi
  parent=$(jq -er '.parent' <<< "$ticket")
  ready_ticket "$1" "$parent"
  check_paths "$ticket" "$(rows)"
  metadata=$(jq -c --arg id "$engineer" '{maestro_dispatch: (.metadata.maestro_dispatch + {thread_id: $id})}' <<< "$ticket")
  write_issue "$ticket" --assignee "$engineer" --status in_progress --metadata "$metadata"
}

bind_child() {
  local id=$1 token=$2 thread=$3 task=${4-} ticket metadata owner
  owner=$(caller)
  [[ -n "$thread" ]] || fail "Need the child thread ID"
  ticket=$(issue "$id")
  if [[ "$id" == maestro-qa-slot || "$id" == maestro-qa-slot-2 ]]; then
    jq -e --arg owner "$owner" --arg token "$token" --arg thread "$thread" --arg task "$task" '
      .status == "in_progress" and .assignee == $owner and .metadata.maestro_qa_batch.token == $token and
      (.metadata | (.qa_thread_id // $thread) == $thread and (.qa_task_id // $task) == $task)
    ' <<< "$ticket" >/dev/null || fail "$id no longer holds that batch"
    metadata=$(jq -c --arg thread "$thread" --arg task "$task" '
      {qa_thread_id: $thread, qa_task_id: $task}
    ' <<< "$ticket")
  else
    jq -e --arg owner "$owner" --arg token "$token" --arg thread "$thread" --arg task "$task" '
      (.assignee // "") as $assignee | ($assignee == "" or $assignee == $thread) and
      (.metadata.engineer_task_id // $task) == $task and
      (.metadata.maestro_dispatch | .planner == $owner and .token == $token and (.thread_id // $thread) == $thread)
    ' <<< "$ticket" >/dev/null || fail "$id no longer holds that reservation"
    metadata=$(jq -c --arg thread "$thread" --arg task "$task" '
      {maestro_dispatch: (.metadata.maestro_dispatch + {thread_id: $thread}), engineer_task_id: $task}
    ' <<< "$ticket")
  fi
  write_issue "$ticket" --metadata "$metadata"
}

sync_qa() {
  local goal board_rows input metadata owner old now seed
  owner=$(caller)
  goal=$(issue "$1")
  jq -e --arg owner "$owner" '.issue_type == "epic" and .status != "closed" and .metadata.planner_thread_id == $owner' \
    <<< "$goal" >/dev/null || fail "You do not hold goal $1"
  input=$(jq -ce '
    select(type == "array" and all(.[];
      (.name | type == "string" and length > 0) and
      (.base | type == "string" and length > 0) and
      (.priority | IN(0, 1, 2, 3)) and
      (.tickets | type == "array" and length > 0 and all(.[]; type == "string" and length > 0)) and
      (.prs | type == "array" and all(.[]; type == "string" and test("^https?://[^/]+/.+"; "i"))) and
      (.prs | length) == (.tickets | length))) |
    map({name, base, priority, tickets, prs}) |
    select(length == (map([.base, .name]) | unique | length))
  ' "$2") || fail "Expected QA batches with name, base, priority, tickets and corresponding PR URLs"
  old=$(jq -c '.metadata.maestro_qa_queue // []' <<< "$goal")
  board_rows=$(rows)
  now=$(date +%s%N)
  seed=$(new_token)
  metadata=$(board_jq '
    {maestro_qa_queue: [
      ($input | to_entries[]) | .key as $index | .value | . as $batch |
      select(valid_batch($batch; $goal.id)) |
      ([$old[] | select(batch_key == ($batch | batch_key))][0] // {eligible_at: $now, token: ($seed + "-" + ($index | tostring))}) as $entry |
      $batch + ($entry | {eligible_at, token})] | sort_by(.base, .name)}
  ' -c --argjson goal "$goal" --argjson input "$input" --argjson old "$old" \
    --arg now "$now" --arg seed "$seed" <<< "$board_rows")
  if [[ "$(jq -c .maestro_qa_queue <<< "$metadata")" != "$old" ]]; then
    write_issue "$goal" --metadata "$metadata"
  fi
}

claim_qa() {
  local board_rows batch slot metadata owner
  owner=$(caller)
  board_rows=$(rows)
  batch=$(board_jq 'next_qa' -c <<< "$board_rows")
  if [[ -z "$batch" ]]; then
    echo null
  elif [[ "$(jq -r .planner_thread_id <<< "$batch")" != "$owner" ]]; then
    jq -c '{state: "waiting", planner_thread_id}' <<< "$batch"
  else
    slot=$(issue "$(jq -r .slot <<< "$batch")")
    metadata=$(jq -c --argjson batch "$batch" '
      {qa_thread_id: null, qa_task_id: null, maestro_qa_batch: $batch}
    ' <<< "$slot")
    write_issue "$slot" --assignee "$owner" --status in_progress --metadata "$metadata"
    jq -c '. + {state: "claimed"}' <<< "$batch"
  fi
}

finish_qa() {
  local slot=$1 batch goal metadata token
  batch=$(jq -c '.metadata.maestro_qa_batch // {}' <<< "$slot")
  token=$(jq -r '.token // empty' <<< "$batch")
  if [[ -n "$token" ]]; then
    goal=$(issue "$(jq -r .goal <<< "$batch")")
    metadata=$(jq -c --arg token "$token" '
      {maestro_qa_queue: (.metadata.maestro_qa_queue // [] | map(select(.token != $token)))}
    ' <<< "$goal")
    write_issue "$goal" --metadata "$metadata" || return
  else
    token=$(new_token)
  fi
  metadata=$(jq -c --arg token "$token" --argjson batch "$batch" '
    . as $slot | .metadata |
    {maestro_qa_receipts: ((.maestro_qa_receipts // []) +
      [{slot: $slot.id, $token, $batch, assignee: $slot.assignee, qa_thread_id, qa_task_id}]),
      maestro_qa_batch: null, qa_thread_id: null, qa_task_id: null}
  ' <<< "$slot")
  write_issue "$slot" --assignee '' --status blocked --metadata "$metadata" || return
  jq -c '.maestro_qa_receipts[-1]' <<< "$metadata"
}

ack_qa() {
  local slot owner goal receipt metadata
  owner=$(caller)
  slot=$(issue "$1")
  receipt=$(jq -ce --arg token "$2" '.metadata.maestro_qa_receipts[]? | select(.token == $token)' <<< "$slot") ||
    fail "No matching QA receipt"
  goal=$(jq -r '.batch.goal // empty' <<< "$receipt")
  if [[ -n "$goal" ]]; then
    goal=$(issue "$goal")
    [[ "$(jq -r '.metadata.planner_thread_id' <<< "$goal")" == "$owner" ]] || fail "Receipt belongs to another goal"
  fi
  metadata=$(jq -c --arg token "$2" '
    {maestro_qa_receipts: (.metadata.maestro_qa_receipts | map(select(.token != $token)))}
  ' <<< "$slot")
  write_issue "$slot" --metadata "$metadata"
}

reap_claims() {
  local board_rows candidates id ticket status assignee qa target
  board_rows=$(rows)
  candidates=$(board_jq '
    .[] | select(if slot then held else
      .issue_type != "epic" and .status != "closed" and (claimed or dispatch != null) end) | .id
  ' -r <<< "$board_rows")
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    ticket=$(issue "$id") || continue
    status=$(jq -r .status <<< "$ticket")
    assignee=$(jq -r '.assignee // ""' <<< "$ticket")
    if [[ "$id" == maestro-qa-slot || "$id" == maestro-qa-slot-2 ]]; then
      [[ "$status" == in_progress ]] || continue
      qa=$(jq -r '.metadata.qa_thread_id // empty' <<< "$ticket")
      thread_ended "${qa:-$assignee}" || continue
    else
      [[ "$status" == open || "$status" == in_progress || "$status" == blocked ]] || continue
      ticket_ended "$ticket" || continue
    fi
    (
      board_lock
      [[ "$ticket" == "$(issue "$id")" ]] || exit 0
      if [[ "$id" == maestro-qa-slot || "$id" == maestro-qa-slot-2 ]]; then
        receipt=$(finish_qa "$ticket")
        board_jq '$receipt + {planner_thread_id: ([$board[] | select(.id == $receipt.batch.goal) | planner][0] // $receipt.assignee)}' \
          -c --argjson receipt "$receipt" <<< "$board_rows"
      else
        target=open
        if [[ "$status" == blocked ]] || { [[ "$status" == in_progress ]] && jq -e '.external_ref' <<< "$ticket" >/dev/null; }; then
          target=$status
        fi
        release_ticket "$ticket" "$target"
        board_jq '$ticket | {ticket: .id, assignee, engineer_thread_id: ((.assignee | select(. != "")) // dispatch.thread_id),
          engineer_task_id: .metadata.engineer_task_id, review_thread_id: .metadata.review_thread_id,
          planner_thread_id: ([goal | planner][0] // null)}' -c --argjson ticket "$ticket" <<< "$board_rows"
      fi
    )
  done <<< "$candidates" | jq -sc .
}

wake_targets() {
  local board_rows changed
  board_rows=$(rows)
  if [[ "$1" == qa ]]; then
    board_jq '[next_qa | .planner_thread_id]' -c <<< "$board_rows"
  else
    changed=$(issue "$1")
    board_jq '[
      $changed, ($board[] | select(.status != "closed" and .id != $changed.id) | select(
        ($changed.status == "closed" and any(.dependencies[]?; .depends_on_id == $changed.id and (.type | IN("blocks", "conditional-blocks", "waits-for", "tracks")))) or
        (.status == "open" and (claimed | not) and dispatch == null and overlap(paths; ($changed | paths))) or
        any(.metadata.maestro_qa_queue[]?.tickets[]; . == $changed.id)
      )) | goal | planner
    ] | unique' -c --argjson changed "$changed" <<< "$board_rows"
  fi
}

unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR
if [[ ${1-} == maestro-engineer-claim ]]; then
  source_root=$(git rev-parse --show-toplevel)
  source_branch=$(git symbolic-ref --quiet --short HEAD || true)
fi
IFS= read -r -d '' worktree < <(git worktree list --porcelain -z)
primary=$(cd "${worktree#worktree }" && pwd -P)
digest=$(printf '%s' "$primary" | sha256sum)
store="$HOME/.local/share/maestro-board"
board="$store/${primary##*/}-${digest:0:12}"
for var in $(compgen -e); do
  case $var in
    BEADS_ACTOR|BD_ACTOR) ;;
    BEADS_*|BD_*) unset "$var" ;;
  esac
done
unset DOLT_ROOT_HOST DOLT_ROOT_PASSWORD
export GIT_CEILING_DIRECTORIES="$store"
export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=beads.role GIT_CONFIG_VALUE_0=maintainer
export BEADS_DIR="$board/.beads" BD_DISABLE_METRICS=1 BD_DISABLE_EVENT_FLUSH=1
export DOLT_ROOT_PATH="$board" DOLT_DISABLE_EVENT_FLUSH=1

setup=
if [[ ${1-} == maestro-setup ]]; then
  setup=1
  shift
  (( $# <= 1 )) || fail "Usage: maestro-bd maestro-setup [port]"
  bd=$(type -P bd) && bd=$(realpath -- "$bd") &&
    "$bd" --version | grep -Eq '^bd version 1\.3\.4( |$)' || fail "Need bd 1.3.4 on PATH"
  for tool in ss setsid flock jq; do command -v "$tool" >/dev/null || fail "Need $tool on PATH"; done
  mkdir -p -- "$store"
  version=$(DOLT_ROOT_PATH="$store" DOLT_DISABLE_VERSION_CHECKS=true dolt version) ||
    fail "Need Dolt 2.2.0 on PATH"
  version=${version%%$'\n'*}
  [[ "$version" == "dolt version 2.2.0" ]] || fail "Need Dolt 2.2.0 on PATH. Found $version"
else
  [[ -f "$BEADS_DIR/metadata.json" && -f "$board/bd.path" ]] ||
    fail "Run .maestro/maestro-bd maestro-setup to set up the board at $board"
  read -r bd < "$board/bd.path"
  [[ "$bd" == /* && -x "$bd" ]] || fail "Verified bd is missing at $bd. Rerun board setup"
fi

umask 077
mkdir -p -- "$board"
cd "$board"
driver=("$bd" --sandbox --dolt-auto-commit on)
export DOLT_DISABLE_VERSION_CHECKS=true
board_lock
saved=
if [[ -f "$BEADS_DIR/metadata.json" ]]; then
  [[ -f "$BEADS_DIR/dolt-server.port" ]] || fail "Missing $BEADS_DIR/dolt-server.port"
  saved=$(<"$BEADS_DIR/dolt-server.port")
fi
port=${saved:-3307}
if [[ -n "$setup" ]]; then port=${1-$port}; fi
[[ "$port" =~ ^[1-9][0-9]{0,4}$ ]] && (( port <= 65535 )) ||
  fail "Invalid board port: $port"
if [[ -n "$setup" ]]; then
  dolt config --global --add metrics.disabled true
fi
pid=
start_server
if [[ -n "$setup" ]]; then
  if [[ ! -f "$BEADS_DIR/metadata.json" ]]; then
    "$bd" --sandbox init --server --external --server-host 127.0.0.1 --server-port "$port" \
      --server-user root --prefix maestro --skip-agents --skip-hooks --non-interactive
  fi
  printf '%s\n' "$port" > "$BEADS_DIR/dolt-server.port"
  printf '%s\n' "$bd" > bd.path
  ensure_qa_slots
  trap - EXIT
  echo "Maestro board running at $board (port $port, PID $pid)"
  exit 0
fi
[[ -f maestro-qa-slots-v2 ]] || ensure_qa_slots
trap - EXIT
exec 9>&-

case ${1-} in
  maestro-*)
    action=${1#maestro-}
    shift
    [[ -z "${T3CODE_THREAD_ID-}" ]] || driver+=(--actor "$T3CODE_THREAD_ID")
    case $action in
      reap) (( $# == 0 )) || fail "Usage: maestro-reap"; reap_claims; exit ;;
      wake-targets) (( $# == 1 )) || fail "Usage: maestro-wake-targets <ticket|qa>"; wake_targets "$1"; exit ;;
    esac
    board_lock
    case $action in
      reserve)
        (( $# == 1 )) || fail "Usage: maestro-reserve <ticket>"
        reserve_ticket "$1" ;;
      reassign)
        (( $# == 4 )) || fail "Usage: maestro-reassign <ticket> <observed assignee> <worktree> <branch>"
        reserve_ticket "$@" ;;
      engineer-claim)
        (( $# == 2 )) || fail "Usage: maestro-engineer-claim <ticket> <token>"
        engineer_claim "$@" ;;
      bind-child)
        (( $# >= 3 && $# <= 4 )) || fail "Usage: maestro-bind-child <ticket|slot> <token> <thread> [task]"
        bind_child "$@" ;;
      release-ticket)
        (( $# == 4 || $# == 5 )) ||
          fail "Usage: maestro-release-ticket <ticket> <observed assignee> <observed status> <open|blocked|in_progress> [token]"
        ticket=$(issue "$1")
        [[ "$(jq -r '.assignee // ""' <<< "$ticket")" == "$2" && "$(jq -r '.status' <<< "$ticket")" == "$3" ]] ||
          fail "$1 changed hands or status"
        [[ "$3" == open || "$3" == blocked || "$3" == in_progress ]] || fail "Cannot release a $3 ticket"
        [[ "$4" == open || "$4" == blocked || "$4" == in_progress ]] || fail "Invalid release status: $4"
        owner=$(caller)
        jq -e --arg token "${5-}" '(.metadata.maestro_dispatch.token // "") == $token' <<< "$ticket" >/dev/null ||
          fail "$1 no longer holds that reservation"
        if [[ "$owner" != "$2" ]] &&
           ! jq -e --arg owner "$owner" '
              (.assignee // "") == "" and (.metadata.maestro_dispatch | .planner == $owner and .thread_id == null)
           ' <<< "$ticket" >/dev/null; then
          ticket_ended "$ticket" || fail "$1 still has live or unverified work"
        fi
        release_ticket "$ticket" "$4" ;;
      qa-sync)
        (( $# == 2 )) || fail "Usage: maestro-qa-sync <epic> <absolute JSON file or ->"
        [[ "$2" == /* || "$2" == - ]] || fail "Use an absolute path for the QA queue file"
        sync_qa "$@" ;;
      qa-claim)
        (( $# == 0 )) || fail "Usage: maestro-qa-claim"
        claim_qa ;;
      qa-ack|qa-check|qa-release)
        (( $# == 2 )) || fail "Usage: maestro-$action <slot> <token>"
        [[ "$1" == maestro-qa-slot || "$1" == maestro-qa-slot-2 ]] || fail "$1 is not a QA slot"
        if [[ "$action" == qa-ack ]]; then
          ack_qa "$@"
        else
          slot=$(issue "$1")
          jq -e --arg token "$2" '.status == "in_progress" and (.metadata.maestro_qa_batch.token // "") == $token' \
            <<< "$slot" >/dev/null || fail "$1 no longer holds that batch"
          owner=$(caller)
          qa=$(jq -r '.metadata.qa_thread_id // empty' <<< "$slot")
          if [[ "$action" == qa-check ]]; then
            [[ "$qa" == "$owner" ]] || fail "$1 is not bound to this QA thread"
          else
            [[ "$(jq -r '.assignee // ""' <<< "$slot")" == "$owner" ]] || fail "$1 is held by another planner"
            [[ -z "$qa" ]] || thread_ended "$qa" || fail "$1 still has live or unverified QA work"
            finish_qa "$slot"
          fi
        fi ;;
      *) fail "Unknown maestro-bd action: maestro-$action" ;;
    esac
    exit ;;
esac

for (( index=1; index<=$#; index++ )); do
  case ${!index} in
    --) break ;;
    --*=*|--cpu-profile|--global|--help|-h|--ignore-schema-skew|--json|--no-color|-q|--quiet|--readonly|--sandbox|-v|--verbose|-V|--version) ;;
    --*|-?) (( index+=1 )) ;;
    -??*) ;;
    *) break ;;
  esac
done
case ${!index-} in
  ready)
    extra=(--limit 0) json= full=
    for arg; do
      case $arg in
        --json|--json=true) json=1 ;;
        --brief|--brief=*|--claim|--claim=*|--gated|--gated=*|--mol|--mol=*|--explain|--explain=*) full=1 ;;
      esac
    done
    [[ -z $json || -n $full ]] || extra+=(--brief)
    [[ -z "$full" ]] || board_lock
    set -- "${@:1:index}" "${extra[@]}" "${@:index+1}" ;;
  list|show|status|version|--help|-h|'') ;;
  *) board_lock ;;
esac
exec "${driver[@]}" "$@"
