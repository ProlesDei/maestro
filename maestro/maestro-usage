#!/usr/bin/env bash
set -eu

mapfile -t providers < <(jq -sr '
  (.[0].providerInstances // {}) as $instances
  | ($instances | to_entries | map(select(.value.enabled == true))) as $enabled
  | ($enabled | map(select(.value.driver == "codex")) | first) as $codex
  | ($codex.key // ""),
    (($codex.value.config.homePath | strings) // ""),
    (($enabled | map(select(.value.driver == "claudeAgent") | .key) | first)
     // if $instances | has("claudeAgent") then "" else "claudeAgent" end)
' "$HOME/.t3/userdata/settings.json" 2>/dev/null)

claude=${providers[2]-claudeAgent}
fallback="provider=none model=none effort=none"
[[ -z "$claude" ]] || fallback="provider=$claude model=claude-opus-5-5 effort=high"
codex=${providers[0]-}
pick=$fallback
if [[ -n "$codex" ]]; then
  pick="provider=$codex model=gpt-6.2-sol effort=high"
  codex_home=${providers[1]:-${CODEX_HOME:-$HOME/.codex}}
  codex_home=${codex_home/#\~\//$HOME/}
  now=$(date +%s)
  while IFS= read -r -d '' entry; do
    if reading=$(grep -F '"rate_limits"' "${entry#* }" 2>/dev/null | tac |
      jq -nRr --argjson now "$now" --arg codex "$pick" --arg claude "$fallback" '
        first(inputs | fromjson? | (.payload.rate_limits? // .rate_limits?)
          | [.primary?, .secondary?]
          | map(select(.used_percent? | numbers)
            | if (.resets_at | type) != "number" then .resets_at = null
              elif .resets_at <= $now then .used_percent = 0 | .resets_at = null
              else . end)
          | max_by(.used_percent) | select(. != null))
        | (if .used_percent >= 96 then $claude else $codex end) as $pick
        | (try (.resets_at | todate) catch null) as $reset
        | "\($pick) codex used=\(.used_percent | floor)%"
          + (if $reset then " resets=\($reset)" else "" end)
      ' 2>/dev/null) && [[ -n "$reading" ]]; then
      printf '%s\n' "$reading"
      exit 0
    fi
  done < <(find "$codex_home/sessions" -name '*.jsonl' -type f -printf '%T@ %p\0' 2>/dev/null | sort -zrn)
fi
printf '%s codex unknown\n' "$pick"
