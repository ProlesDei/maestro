#!/usr/bin/env bash
set -eu
shopt -s nullglob dotglob
caller_umask=$(umask)
umask 077

fail() {
  printf 'Maestro: %s\n' "$*" >&2
  exit 1
}

usage='Usage: maestro-run make <role> <ticket-or-batch> | start <name> -- <cmd> [args...] | stop <name> | clean [thread-id] | prune'
role_pattern='[a-zA-Z0-9]+(-[a-zA-Z0-9]+)*'
label_pattern='[a-zA-Z0-9][a-zA-Z0-9._-]*'
uuid='[a-fA-F0-9]{8}(-[a-fA-F0-9]{4}){3}-[a-fA-F0-9]{12}'
run_pattern="maestro-$role_pattern-$label_pattern-$uuid"

thread_key() {
  local id=$1 hash
  [[ -n $id ]] || fail 'Need a thread ID'
  if [[ $id =~ ^$uuid$ ]]; then
    printf '%s\n' "${id,,}"
  else
    hash=$(printf '%s' "$id" | sha256sum)
    printf '%s-%s-%s-%s-%s\n' "${hash:0:8}" "${hash:8:4}" "${hash:12:4}" "${hash:16:4}" "${hash:20:12}"
  fi
}

managed_run() {
  [[ ${1##*/} =~ ^$run_pattern$ && -d $1 && -O $1 && ! -L $1 &&
     -f $1/thread && -s $1/thread && ! -L $1/thread &&
     -f $1/git-common-dir && -s $1/git-common-dir && ! -L $1/git-common-dir ]]
}

read_thread() {
  local -a value
  mapfile -d '' -t value 2>/dev/null < "$1/thread" || return 1
  id=${value[0]-}
  [[ -n $id ]]
}

own_run() {
  local dir
  run=
  for dir in "${root%/}"/maestro-*-"$key"; do
    managed_run "$dir" || continue
    [[ -z $run ]] || fail 'Thread has more than one run'
    run=$dir
  done
  [[ -n $run ]]
}

proc_stat() {
  local line
  local -a stat
  [[ -O /proc/$1 ]] || return 1
  mapfile -d '' -t stat 2>/dev/null < "/proc/$1/stat" || return 1
  line=${stat[0]-}
  read -r -a fields <<< "${line##*) }"
  [[ ${#fields[@]} -ge 20 ]]
}

proc_live() {
  proc_stat "$1" && [[ ${fields[0]} != Z && ${fields[0]} != X ]]
}

match_paths() {
  local arg=$1 prefix=${root%/}/ match
  [[ $arg == *"$prefix"* ]] || return 0
  while [[ $arg =~ (^|[=[:space:]:])"$prefix"($run_pattern)(/|:|[[:space:]]|$) ]]; do
    matched[${BASH_REMATCH[2]}]=1
    match=${BASH_REMATCH[1]}$prefix${BASH_REMATCH[2]}
    arg=x${arg#*"$match"}
  done
}

scan_processes() {
  local mode=$1 proc pid part value cwd name id tagged
  local -a fields values
  local -A matched
  births=() by_group=() by_run=()
  for proc in /proc/[0-9]*; do
    pid=${proc##*/}
    proc_live "$pid" 2>/dev/null || continue
    births[$pid]=${fields[19]}
    pgid=${fields[2]}
    by_group[${fields[3]}]+=" $pid"
    [[ $mode != groups ]] || continue
    matched=()
    id='' tagged=no
    for part in environ cmdline; do
      mapfile -d '' -t values 2>/dev/null < "$proc/$part" || continue
      for value in "${values[@]}"; do
        case $part:$value in environ:OLDPWD=*) continue ;; esac
        match_paths "$value"
        [[ $mode == report && $part == environ ]] || continue
        case $value in
          T3CODE_THREAD_ID=*) id=${value#*=} ;;
          MAESTRO_RUN=?*) tagged=yes ;;
        esac
      done
    done
    cwd=$(readlink -- "$proc/cwd" 2>/dev/null) || cwd=
    if [[ $cwd == "${root%/}/"* ]]; then
      name=${cwd#"${root%/}/"}
      name=${name% (deleted)}
      name=${name%%/*}
      if [[ $name =~ ^$run_pattern$ ]]; then matched[$name]=1; fi
    fi
    for name in "${!matched[@]}"; do
      by_run[$name]+=" $pid"
      if [[ $mode == report && ${dirs[$name]+yes} ]]; then tagged=yes; fi
    done
    if [[ -n $id && $tagged == no && $pid != "$$" && $pid != "$BASHPID" ]]; then
      untagged[$pid]=$id
    fi
  done
}

collect_targets() {
  local pid pgid list=''
  local -a pids=()
  for pgid in "${!groups[@]}"; do
    list+=${by_group[$pgid]-}
  done
  if [[ $mode != groups ]]; then list+=${by_run[${run##*/}]-}; fi
  read -r -a pids <<< "$list"
  for pid in "${pids[@]}"; do
    if [[ ! ${spared[$pid]+yes} ]]; then targets[$pid]=${births[$pid]}; fi
  done
}

target_alive() {
  proc_live "$1" && [[ ${fields[19]} == "${targets[$1]}" ]]
}

signal_targets() {
  local pid
  for pid in "${!targets[@]}"; do
    if target_alive "$pid"; then
      kill -s "$1" "$pid" 2>/dev/null || true
    fi
  done
}

targets_alive() {
  local pid
  for pid in "${!targets[@]}"; do
    target_alive "$pid" && return 0
  done
  return 1
}

stop_processes() {
  local mode=$1 record pid pgid birth deadline
  shift
  local -a fields
  local -A groups=() targets=() spared=()
  pid=$BASHPID
  while proc_stat "$pid"; do
    spared[$pid]=1
    pid=${fields[1]}
  done
  for record in "$@"; do
    [[ -f $record && ! -L $record && ! -L ${record%/*} && ! -L ${record%/*/*} ]] || continue
    { read -r pid pgid birth < "$record"; } 2>/dev/null || continue
    [[ $pid =~ ^[1-9][0-9]*$ && $pid == "$pgid" && $birth =~ ^[0-9]+$ ]] || continue
    if proc_stat "$pid" && [[ ${fields[19]} == "$birth" ]]; then groups[$pgid]=1; fi
  done
  [[ $mode != groups || ${#groups[@]} -gt 0 ]] || return 0
  deadline=$((SECONDS + 10))
  while true; do
    scan_processes "$mode"
    collect_targets
    targets_alive || return 0
    if (( SECONDS >= deadline )); then break; fi
    signal_targets TERM
    while targets_alive && (( SECONDS < deadline )); do sleep 0.1; done
  done
  signal_targets KILL
  deadline=$((SECONDS + 2))
  while targets_alive && (( SECONDS < deadline )); do sleep 0.1; done
  scan_processes "$mode"
  collect_targets
  ! targets_alive
}

unmounted() {
  local path
  while read -r _ _ _ _ path _; do
    printf -v path '%b' "$path"
    if [[ $path == "$1" || $path == "$1/"* ]]; then
      printf 'Maestro: Mount at %s blocks cleanup\n' "$path" >&2
      return 1
    fi
  done < /proc/self/mountinfo
}

remove_worktrees() {
  local run=$1 common_dir=$2 record path
  [[ $common_dir == /* && -d $common_dir && ! -L $common_dir/worktrees ]] || return 0
  for record in "$common_dir"/worktrees/*/gitdir; do
    [[ -f $record && ! -L $record && ! -L ${record%/*} ]] || continue
    path=$(< "$record") || return 1
    [[ -n $path ]] || continue
    if [[ $path != /* ]]; then path=${record%/*}/$path; fi
    path=$(realpath -m -- "$path") || return 1
    if [[ $path == "$run/"* ]]; then
      rm -rf --one-file-system --preserve-root=all -- "${record%/*}" || return 1
    fi
  done
}

clean_run() {
  local run=$1 mode=$2 common_dir id entry
  local -a children=()
  managed_run "$run" || return 0
  common_dir=$(< "$run/git-common-dir") && read_thread "$run" || return 1
  unmounted "$run" || return 1
  if ! stop_processes "$mode" "$run"/services/*/pid; then
    printf 'Maestro: Processes survived in %s\n' "${run##*/}" >&2
    return 1
  fi
  unmounted "$run" || return 1
  for entry in "$run"/*; do
    case ${entry##*/} in thread|git-common-dir) continue ;; esac
    children+=("$entry")
  done
  chmod u+rwx -- "$run" || return 1
  if ! rm -rf --one-file-system --preserve-root=all -- "${children[@]}" 2>/dev/null; then
    unmounted "$run" &&
      find "$run" -xdev -type d ! -perm -u=rwx -exec chmod u+rwx -- {} + &&
      rm -rf --one-file-system --preserve-root=all -- "${children[@]}" || return 1
  fi
  remove_worktrees "$run" "$common_dir" || return 1
  if ! { rm -- "$run/thread" "$run/git-common-dir" && rmdir -- "$run"; }; then
    printf '%s' "$id" > "$run/thread"
    printf '%s\n' "$common_dir" > "$run/git-common-dir"
    return 1
  fi
  printf 'Removed %s\n' "${run##*/}"
}

recent() {
  [[ -n $(find "$1" ! -type l -mmin "-$grace" -print -quit 2>/dev/null) ]]
}

check_thread() {
  local key=$1 id=$2 state
  state=$("$(dirname -- "${BASH_SOURCE[0]}")/maestro-bd" maestro-session "$id" "${3-}") || return 1
  case $state in
    ended|gone) liveness[$key]=dead ;;
    *) liveness[$key]=live ;;
  esac
}

prune() {
  local keep=${1-} grace=${MAESTRO_RUN_GRACE_MIN:-60} run id pid common_dir status=0
  local -A dirs=() ids=() liveness=() untagged=() births=() by_group=() by_run=()
  [[ $grace =~ ^[0-9]+$ ]] || fail 'MAESTRO_RUN_GRACE_MIN must be a whole number'
  if ! command -v t3 >/dev/null; then
    printf 'Maestro: T3 unavailable, keeping runs\n' >&2
    return 0
  fi
  for run in "${root%/}"/maestro-*; do
    managed_run "$run" || continue
    dirs[${run##*/}]=1
    if [[ $run == "$keep" ]] || recent "$run" || ! read_thread "$run"; then continue; fi
    ids[$run]=$id
  done
  if [[ -z $keep ]]; then scan_processes report; fi
  for run in "${!ids[@]}"; do
    common_dir=$(< "$run/git-common-dir") && [[ $common_dir == /* ]] || continue
    if ! check_thread "$run" "${ids[$run]}" "$common_dir"; then
      printf 'Maestro: T3 unavailable, keeping runs\n' >&2
      return 0
    fi
  done
  common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || common_dir=
  for id in "${untagged[@]}"; do
    if [[ ! ${liveness[$id]+yes} ]] && ! check_thread "$id" "$id" "$common_dir"; then
      printf 'Maestro: T3 unavailable, keeping runs\n' >&2
      return 0
    fi
  done
  for pid in "${!untagged[@]}"; do
    id=${untagged[$pid]}
    if [[ ${liveness[$id]} == dead ]]; then
      printf 'Maestro: Untagged PID %s for dead thread %s\n' "$pid" "$id"
    fi
  done
  for run in "${!ids[@]}"; do
    [[ ${liveness[$run]-} == dead ]] || continue
    if ! read_thread "$run" || [[ $id != "${ids[$run]}" ]] || recent "$run"; then continue; fi
    clean_run "$run" runs || status=1
  done
  return "$status"
}

auto_prune() (
  local stamp=$root/.maestro-prune fd now last
  [[ ! -L $stamp ]] || return 1
  exec {fd}>> "$stamp"
  flock -n "$fd" || return 0
  now=$(date +%s)
  read -r last < "$stamp" || last=0
  if [[ $last =~ ^[0-9]{1,12}$ ]] && (( now - 10#$last < 600 )); then return 0; fi
  printf '%s\n' "$now" > "$stamp"
  prune "$1"
)

root_probe() {
  probe=$root
  while [[ ! -e $probe ]]; do probe=${probe%/*}; probe=${probe:-/}; done
}

action=${1-}
case $action in
  make)
    (( $# == 3 )) || fail "$usage"
    [[ $2 =~ ^$role_pattern$ && $3 =~ ^$label_pattern$ ]] || fail 'Invalid role or ticket/batch name'
    ;;
  start)
    (( $# >= 4 )) && [[ $2 =~ ^$label_pattern$ && $3 == -- ]] || fail "$usage"
    ;;
  stop)
    (( $# == 2 )) && [[ $2 =~ ^$label_pattern$ ]] || fail "$usage"
    ;;
  clean) (( $# <= 2 )) || fail "$usage" ;;
  prune) (( $# == 1 )) || fail "$usage" ;;
  *) fail "$usage" ;;
esac

if [[ $action != prune ]]; then
  thread=${T3CODE_THREAD_ID-}
  if [[ $action == clean && $# == 2 ]]; then thread=$2; fi
  key=$(thread_key "$thread")
fi
root=$(realpath -m -- "${MAESTRO_RUN_ROOT-$HOME/.local/share/maestro-runs}")
if top=$(git rev-parse --show-toplevel 2>/dev/null); then
  device=$(stat -Lc %d -- "$top")
  root_probe
  root_device=$(stat -Lc %d -- "$probe")
  if [[ $action == make ]]; then
    common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || fail 'Cannot find Git common dir'
  elif [[ $root_device != "$device" ]]; then
    common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || common=
  fi
  if [[ $root_device != "$device" && -n ${common-} ]]; then
    root=$(realpath -m -- "$common/maestro-runs")
    root_probe
  fi
  if [[ $action == make ]]; then
    [[ $(stat -fc %T -- "$probe") != tmpfs ]] || fail "Run root is on tmpfs: $root"
    [[ $(stat -Lc %d -- "$probe") == "$device" ]] || fail "Run root is on a different device from the checkout: $root"
  fi
elif [[ $action == make ]]; then
  fail 'Need a Git checkout'
fi

declare -A births=() by_group=() by_run=()
case $action in
  make)
    mkdir -p -- "$root"
    exec {fd}< "$root"
    flock "$fd"
    creating=no
    if ! own_run; then
      creating=yes
      run=${root%/}/maestro-$2-$3-$key
      if ! mkdir -m 700 -- "$run" 2>/dev/null; then
        [[ -d $run && -O $run && ! -L $run ]] || fail "Cannot create $run"
      fi
    fi
    for entry in thread git-common-dir tmp logs services; do
      [[ ! -L $run/$entry ]] || fail "Invalid run entry in $run"
    done
    mkdir -p -- "$run/tmp" "$run/logs" "$run/services"
    if [[ $creating == yes ]]; then
      printf '%s' "$thread" > "$run/thread"
      printf '%s\n' "$common" > "$run/git-common-dir"
    else
      touch -- "$run/thread"
    fi
    exec {fd}<&-
    auto_prune "$run" >/dev/null 2>&1 || true
    printf '%s\n' "$run"
    ;;
  start)
    own_run || fail 'Thread has no run'
    record=$run/services/$2
    log=$run/logs/$2.log
    [[ ! -L $run/services && ! -L $run/logs && ! -L $log ]] || fail 'Invalid service paths'
    name=$2
    shift 3
    type -P -- "$1" >/dev/null || fail "Command not found: $1"
    mkdir -- "$record" || fail "Cannot reserve service $name"
    IFS= read -r -d '' launcher <<'LAUNCH' || true
      IFS= read -r line < "/proc/$$/stat" || exit 1
      read -r -a fields <<< "${line##*) }"
      printf "%s %s %s\n" "$$" "${fields[2]}" "${fields[19]}" > "$1/starting" &&
        mv -T -- "$1/starting" "$1/pid" || exit 1
      umask "$2"
      shift 2
      exec "$@"
LAUNCH
    set +m
    TMPDIR=$run/tmp MAESTRO_RUN=$run setsid bash -c "$launcher" bash "$record" "$caller_umask" "$@" \
      </dev/null >> "$log" 2>&1 &
    pid=$!
    while [[ ! -s $record/pid ]]; do
      if ! kill -0 "$pid" 2>/dev/null; then
        [[ -s $record/pid ]] && break
        rm -rf -- "$record"
        fail "Could not start service, see $log"
      fi
      sleep 0.01
    done
    printf '%s %s\n' "$pid" "$log"
    ;;
  stop)
    own_run || fail 'Thread has no run'
    [[ ! -L $run/services ]] || fail 'Invalid service paths'
    stop_processes groups "$run/services/$2/pid" || fail "Processes survived for service $2"
    rm -rf -- "$run/services/$2"
    ;;
  clean)
    status=0
    for run in "${root%/}"/maestro-*-"$key"; do
      clean_run "$run" runs || status=1
    done
    exit "$status"
    ;;
  prune) prune ;;
esac
