$ maestro-ticket ack R-1 R-2
exit 0
stdout:
acked R-1
acked R-2
$ maestro-ticket ack R-1
exit 0
stdout:
R-1 was already acked by senior-engineer
$ maestro-ticket ack R-3
exit 4
stderr:
maestro-ticket: status conflict: ack: run R-3 is running: ack it once pickup shows it ended
$ maestro-ticket ack R-4
exit 2
stderr:
maestro-ticket: not allowed for this actor: ack: run R-4 is reviewer's: only the bot that launched it acks it
$ maestro-ticket ack R-zzzzzzzz
exit 3
stderr:
maestro-ticket: not found: run R-zzzzzzzz
$ maestro-ticket ack nope
exit 2
stderr:
maestro-ticket: ack: "nope" is not a run id, such as R-abcdefgh
$ maestro-ticket ack
exit 2
stderr:
maestro-ticket: ack: name the run ids pickup showed
$ maestro-ticket ack R-1 R-2 --json
exit 0
stdout:
{
  "acks": [
    {
      "run": "R-1",
      "acked": true,
      "acked_by": "senior-engineer",
      "acked_at": "T"
    },
    {
      "run": "R-2",
      "acked": true,
      "acked_by": "senior-engineer",
      "acked_at": "T"
    }
  ]
}
$ maestro-ticket ack R-1 --json
exit 0
stdout:
{
  "acks": [
    {
      "run": "R-1",
      "acked": false,
      "acked_by": "senior-engineer",
      "acked_at": "T"
    }
  ]
}
$ maestro-ticket ack R-3 --json
exit 4
stdout:
{
  "error": {
    "code": "status_conflict",
    "message": "status conflict: ack: run R-3 is running: ack it once pickup shows it ended"
  }
}
$ maestro-ticket ack R-4 --json
exit 2
stdout:
{
  "error": {
    "code": "forbidden",
    "message": "not allowed for this actor: ack: run R-4 is reviewer's: only the bot that launched it acks it"
  }
}
$ maestro-ticket ack R-zzzzzzzz --json
exit 3
stdout:
{
  "error": {
    "code": "not_found",
    "message": "not found: run R-zzzzzzzz"
  }
}
$ maestro-ticket ack nope --json
exit 2
stdout:
{
  "error": {
    "code": "usage",
    "message": "ack: \"nope\" is not a run id, such as R-abcdefgh"
  }
}
$ maestro-ticket ack --json
exit 2
stdout:
{
  "error": {
    "code": "usage",
    "message": "ack: name the run ids pickup showed"
  }
}
